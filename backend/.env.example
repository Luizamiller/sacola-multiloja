# Copie para backend/.env (não versionado).
# Banco local (padrão) — em produção use Postgres:
# DATABASE_URL=postgresql+psycopg://sacola:sacola@localhost:5432/sacola
# Assistente: sem chave, usa o planejador determinístico. Com chave, usa o Claude com tool use.
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-sonnet-5-5
# auto | claude | deterministico
MOTOR_ASSISTENTE=auto
LOG_LEVEL=INFO

# Autenticação. "teste" = nada é enviado; códigos na caixa de testes (só em desenvolvimento).
AUTH_MODO=teste
# Em produção: AMBIENTE=producao, SEGREDO longo e aleatório, COOKIE_SEGURO=true
# SEGREDO=
# WhatsApp Business Cloud API (Meta) — modelo de categoria AUTHENTICATION aprovado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=umami_codigo
# SMTP para o código por e-mail
# SMTP_HOST=
# SMTP_USUARIO=
# SMTP_SENHA=
