{
  "name": "sacola-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5104 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5104",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:demo": "python scripts/empacotar_demo.py backend/app backend/data && tsc -b && vite build --mode demo && python scripts/finalizar_demo.py"
  },
  "pnpm": {
    "overrides": {
      "rolldown": "1.2.18"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vite": "8.3.7",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.21.0"
}
